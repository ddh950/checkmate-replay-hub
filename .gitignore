# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files containing local configuration or secrets
*.tfvars
*.tfvars.json

# Terraform lock file: intentionally tracked
!**/.terraform.lock.hcl

# AWS credentials
.aws/
.aws-credentials
credentials

# Environment variables and secrets
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
